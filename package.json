{
  "name": "jexfold",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "codecs:build": "node scripts/build-codecs.mjs",
    "codecs:check": "node scripts/check-codecs.mjs",
    "wasm:build": "node scripts/build-wasm.mjs",
    "web:build": "tsc --noEmit && vite build",
    "desktop:build": "pnpm run codecs:check && tauri build",
    "test": "node --test tests/format.test.mjs tests/project.test.mjs",
    "check": "pnpm test && pnpm run build",
    "test:rust": "cargo test -p jxl-core",
    "test:integration": "node scripts/test-integration.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-intl": "^10.2.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.9.2",
    "vite": "^6.3.6"
  }
}
