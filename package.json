{
  "name": "jexfold",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "codecs:build": "node scripts/build-codecs.mjs",
    "codecs:check": "node scripts/check-codecs.mjs",
    "wasm:build": "node scripts/build-wasm.mjs",
    "web:build": "tsc --noEmit && vite build",
    "lint": "pnpm run lint:web && pnpm run lint:rust && pnpm run lint:cpp && pnpm run lint:shell && pnpm run lint:actions",
    "lint:web": "eslint .",
    "lint:rust": "cargo clippy --workspace --all-targets --all-features --locked -- -D warnings",
    "lint:cpp": "clang-tidy wasm/src/jexfold_codec.cc -- -std=c++17 -I.tools/libjxl-v0.12.0/include",
    "lint:shell": "node scripts/lint-shell.mjs",
    "lint:actions": "actionlint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write . && cargo fmt --all && pnpm run format:cpp",
    "format:check": "prettier --check . && cargo fmt --all -- --check && pnpm run format:cpp:check",
    "format:cpp": "clang-format -i wasm/src/jexfold_codec.cc",
    "format:cpp:check": "clang-format --dry-run --Werror wasm/src/jexfold_codec.cc",
    "desktop:build": "pnpm run codecs:check && tauri build",
    "desktop:portable": "pnpm run codecs:check && tauri build --no-bundle && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-portable.ps1",
    "test": "node --test tests/format.test.mjs tests/project.test.mjs",
    "check": "pnpm test && pnpm run build",
    "test:rust": "cargo test -p jxl-core",
    "test:integration": "node scripts/test-integration.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-intl": "10.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.3.6"
  }
}
